// ===========================================================================
// 概要: ポストプロセスの全エフェクトが使う頂点シェーダー。画面を覆う三角形を1枚作る
//
// 入力: 頂点の番号だけ（C++ は頂点バッファなしで Draw(3, 0) を呼ぶ）
// 出力: 画面の位置と UV（画面の中は 0〜1）
//
// 備考: 四角形を2枚の三角形で描くと、つなぎ目のピクセルを2回塗る。1枚の大きな三角形ならそれがない
// ===========================================================================
#include "Shader/PostProcess/Bloom.hlsli"

VS_OUT main(uint vertexID : SV_VertexID)
{
    VS_OUT output;

    // 頂点 0, 1, 2 から (-1, 1), (3, 1), (-1, -3) の三角形を作る
    // UV は (0,0), (2,0), (0,2) になり、画面に入る部分がちょうど 0〜1 になる
    float2 grid = float2((vertexID << 1) & 2, vertexID & 2);
    float2 xy = grid * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f);

    output.position = float4(xy, 0.0f, 1.0f);
    output.texcoord = grid;

    return output;
}