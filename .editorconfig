root = true

# ==========================================================
# C++やシェーダーなどのテキストファイルに限定する
# ==========================================================
[*.{cpp,h,hpp,hlsl,hlsli,json,lua}]

charset = utf-8
# インデントはスペース4（.clang-format の Microsoft ベースと統一）
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true