{
    "version": "2.0.0",
    "tasks":
    [
        {
            "label": "Build Debug",
            "type": "shell",

            "command": "msbuild",

            "args":
            [
                "ProgressEngine.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],

            "group":
            {
                "kind": "build",
                "isDefault": true
            },

            "problemMatcher": "$msCompile"
        },

        {
            "label": "Run Debug",

            "type": "shell",

            "command": "Build/bin/x64/Debug/ProgressEngine.exe",

            "options":
            {
                "cwd": "${workspaceFolder}"
            }
        },

        {
            "label": "Build & Run",

            "dependsOrder": "sequence",

            "dependsOn":
            [
                "Build Debug",
                "Run Debug"
            ]
        }
    ]
}