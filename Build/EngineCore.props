<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- ========================================== -->
	<!--  外部ライブラリ用パスの自動ルーティング -->
	<!-- ========================================== -->
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<ExtLibDirName>Debug</ExtLibDirName>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Shipping'">
		<!-- Shipping構成の時は Distribution フォルダを見に行く -->
		<ExtLibDirName>Distribution</ExtLibDirName>
	</PropertyGroup>
	<PropertyGroup Condition="!$(Configuration.Contains('Debug'))">
		<ExtLibDirName>Release</ExtLibDirName>
	</PropertyGroup>
	
	<!-- ========================================== -->
	<!--  全構成共通の基本設定 -->
	<!-- ========================================== -->
	<ItemDefinitionGroup>
		<!-- ===== C++ Compile (ゲームコアのみ) ===== -->
		<ClCompile>
			<!-- ========================================================= -->
			<!-- Debug と Development の時は Joltのデバッグマクロを入れる -->
			<!-- ========================================================= -->
			<PreprocessorDefinitions Condition="'$(Configuration)'!='Shipping'">
				_WINDOWS;
				JPH_FLOATING_POINT_EXCEPTIONS_ENABLED;
				JPH_PROFILE_ENABLED;
				JPH_DEBUG_RENDERER;
				JPH_OBJECT_STREAM;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>

			<!-- ========================================================= -->
			<!-- JPH_ENABLE_ASSERTS は「定義してはいけない」 -->
			<!--
			     ここには以前 Debug 構成向けに JPH_ENABLE_ASSERTS を足していたが、
			     それをすると起動時に Jolt が abort する（RegisterTypes の中）。
			     理由は Jolt が同じマクロを「2箇所・別タイミング」で見ているため。

			     ① Core.h の先頭（8〜71行目）
			        #ifdef JPH_ENABLE_ASSERTS -> JPH_VERSION_FEATURE_BIT_10 = 1
			        ヘッダの一番最初なので、コマンドラインの /D しか見えない。
			        このビットが JPH_VERSION_ID に入り、RegisterTypes() が実行時に
			        lib 側の ID と照合する。1ビットでも食い違えば std::abort()。

			     ② Core.h:515 で JPH_DEBUG が !defined(NDEBUG) から作られ、その後
			        IssueReporting.h:13-16 が「Always turn on asserts in Debug mode」
			        として JPH_ENABLE_ASSERTS を自動で定義する。
			        アサートの有効/無効と構造体レイアウトを実際に決めるのはこちら。

			     lib/Debug/Jolt.lib は /D なしでビルドされている。つまり
			       ・②の自動ONでアサートは有効（AssertFailed シンボルを持つ）
			       ・しかし①のビットは 0
			     この状態で本体側だけ /D JPH_ENABLE_ASSERTS を付けると、機能は同じ
			     なのに ID だけ 1 と 0 で食い違い、起動時に
			       [Jolt] Mismatching define JPH_ENABLE_ASSERTS.
			     で落ちる。lib は事前ビルド済みなのでクリーンビルドでも直らない。

			     定義しなければ本体も②の経路でアサートが有効になり、レイアウトも
			     バージョンIDも lib と一致する。だから「書かない」が正解。

			     Release / Development は NDEBUG を定義するので JPH_DEBUG が立たず、
			     ②も走らない。アサート無効の lib/Release・lib/Distribution と一致する。
			-->

			<!-- ========================================================= -->
			<!-- 2. Development 構成 (アサートなし / Release DLL / JoltデバッグON) -->
			<!-- ========================================================= -->
			<PreprocessorDefinitions Condition="!$(Configuration.Contains('Debug')) and '$(Configuration)'!='Shipping'">
				_WINDOWS;
				NDEBUG;
				JPH_FLOATING_POINT_EXCEPTIONS_ENABLED;
				JPH_PROFILE_ENABLED;
				JPH_DEBUG_RENDERER;
				JPH_OBJECT_STREAM;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
			<RuntimeLibrary Condition="!$(Configuration.Contains('Debug')) and '$(Configuration)'!='Shipping'">MultiThreadedDLL</RuntimeLibrary>

			<!-- ========================================================= -->
			<!-- Shipping の時は Joltのデバッグマクロを全て外す -->
			<!-- ========================================================= -->
			<PreprocessorDefinitions Condition="'$(Configuration)'=='Shipping'">
				_WINDOWS;
				NDEBUG;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
			
			

			<AdditionalIncludeDirectories>
				$(SolutionDir)Source;
				$(SolutionDir)External\cereal\include;
				$(SolutionDir)External\tinygltf;
				$(SolutionDir)External\DirectXTex;
				$(SolutionDir)External\nlohmann;
				$(SolutionDir)External\DirectXTK-main\Inc;
				$(SolutionDir)External\JoltPhysics\include;
				$(SolutionDir)External\meshoptimizer\src;
				$(SolutionDir)External\stb;

				<!-- Tracy のヘッダは全構成で #include される（コード側は無条件 include）。
				     TRACY_ENABLE 未定義（Shipping）なら全マクロが no-op になるだけなので、
				     ヘッダ探索パスは共通のここに置いて全構成で見つかるようにする。 -->
				$(SolutionDir)External\Tracy;

				<!-- ImGui のコアも Tracy と同じ扱いにする。System の OnGui は全構成で
				     コンパイルし、呼ぶかどうかだけを実行時に決める（Framework 側で分岐）。
				     こうしないと OnGui を持つ全システムが #ifdef で二重定義になり、
				     Debug と Release でコードパスが分かれて「Releaseだけ壊れる」の温床になる。
				     エディタ本体（node-editor/ImGuizmo/implot/Source\Editor）は
				     EditorTooling.props 側に残し、Shipping には入れない。 -->
				$(SolutionDir)External\imgui-docking;

				$(ProjectDir)Engine\Core;
				
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>

		<!-- ===== Linker (ゲームコアのみ) ===== -->
		<Link>
			<AdditionalLibraryDirectories>
				<!-- $(Configuration) ではなく $(ExtLibDirName) を使用する -->
				$(SolutionDir)External\JoltPhysics\lib\$(ExtLibDirName);
				$(SolutionDir)External\DirectXTK-main\Bin\Desktop_2022\x64\$(ExtLibDirName);
				%(AdditionalLibraryDirectories)
			</AdditionalLibraryDirectories>
			<AdditionalDependencies>
				d3d11.lib;
				DirectXTK.lib;
				dxgi.lib;xinput.lib;
				xaudio2.lib;winmm.lib;
				Jolt.lib;
				%(AdditionalDependencies)
			</AdditionalDependencies>
		</Link>

		<PreBuildEvent>
			<Command>
				
				%(Command)
			</Command>
		</PreBuildEvent>

			<PostBuildEvent>
			<Command>
				%(Command)
			</Command>
		</PostBuildEvent>

	</ItemDefinitionGroup>

</Project>
