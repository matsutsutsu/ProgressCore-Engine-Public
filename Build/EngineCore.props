<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- ========================================== -->
	<!--  外部ライブラリ用パスの自動ルーティング -->
	<!-- ========================================== -->
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<ExtLibDirName>Debug</ExtLibDirName>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Shipping'">
		<!-- Shipping構成の時は Distribution フォルダを見に行く -->
		<ExtLibDirName>Distribution</ExtLibDirName>
	</PropertyGroup>
	<PropertyGroup Condition="!$(Configuration.Contains('Debug'))">
		<ExtLibDirName>Release</ExtLibDirName>
	</PropertyGroup>
	
	<!-- ========================================== -->
	<!--  全構成共通の基本設定 -->
	<!-- ========================================== -->
	<ItemDefinitionGroup>
		<!-- ===== C++ Compile (ゲームコアのみ) ===== -->
		<ClCompile>
			<!-- ========================================================= -->
			<!-- ★ Debug と Development の時は Joltのデバッグマクロを入れる -->
			<!-- ========================================================= -->
			<PreprocessorDefinitions Condition="'$(Configuration)'!='Shipping'">
				_WINDOWS;
				JPH_FLOATING_POINT_EXCEPTIONS_ENABLED;
				JPH_PROFILE_ENABLED;
				JPH_DEBUG_RENDERER;
				JPH_OBJECT_STREAM;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>

			<!-- ========================================================= -->
			<!-- 2. Development 構成 (アサートなし / Release DLL / JoltデバッグON) -->
			<!-- ========================================================= -->
			<PreprocessorDefinitions Condition="!$(Configuration.Contains('Debug')) and '$(Configuration)'!='Shipping'">
				_WINDOWS;
				NDEBUG;
				JPH_FLOATING_POINT_EXCEPTIONS_ENABLED;
				JPH_PROFILE_ENABLED;
				JPH_DEBUG_RENDERER;
				JPH_OBJECT_STREAM;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
			<RuntimeLibrary Condition="!$(Configuration.Contains('Debug')) and '$(Configuration)'!='Shipping'">MultiThreadedDLL</RuntimeLibrary>

			<!-- ========================================================= -->
			<!-- ★ Shipping の時は Joltのデバッグマクロを全て外す -->
			<!-- ========================================================= -->
			<PreprocessorDefinitions Condition="'$(Configuration)'=='Shipping'">
				_WINDOWS;
				NDEBUG;
				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
			
			

			<AdditionalIncludeDirectories>
				$(SolutionDir)Source;
				$(SolutionDir)External\cereal\include;
				$(SolutionDir)External\tinygltf;
				$(SolutionDir)External\DirectXTex;
				$(SolutionDir)External\nlohmann;
				$(SolutionDir)External\DirectXTK-main\Inc;
				$(SolutionDir)External\Lua\src;
				$(SolutionDir)External\sol2\include;
				$(SolutionDir)External\JoltPhysics\include;
				$(SolutionDir)External\RecastNavigation\Recast\Include;
				$(SolutionDir)External\RecastNavigation\Detour\Include;
				$(SolutionDir)External\RecastNavigation\DetourTileCache\Include;
				$(SolutionDir)External\RecastNavigation\DetourCrowd\Include;
				$(SolutionDir)External\RecastNavigation\DebugUtils\Include;
				$(SolutionDir)External\stb;

				<!-- Tracy のヘッダは全構成で #include される（コード側は無条件 include）。
				     TRACY_ENABLE 未定義（Shipping）なら全マクロが no-op になるだけなので、
				     ヘッダ探索パスは共通のここに置いて全構成で見つかるようにする。 -->
				$(SolutionDir)External\Tracy;

				$(ProjectDir)Engine\Core;
				
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>

		<!-- ===== Linker (ゲームコアのみ) ===== -->
		<Link>
			<AdditionalLibraryDirectories>
				<!-- $(Configuration) ではなく $(ExtLibDirName) を使用する -->
				$(SolutionDir)External\JoltPhysics\lib\$(ExtLibDirName);
				$(SolutionDir)External\DirectXTK-main\Bin\Desktop_2022\x64\$(ExtLibDirName);
				%(AdditionalLibraryDirectories)
			</AdditionalLibraryDirectories>
			<AdditionalDependencies>
				d3d11.lib;
				DirectXTK.lib;
				dxgi.lib;xinput.lib;
				xaudio2.lib;winmm.lib;
				Jolt.lib;
				%(AdditionalDependencies)
			</AdditionalDependencies>
		</Link>

		<PreBuildEvent>
			<Command>
				
				%(Command)
			</Command>
		</PreBuildEvent>

			<PostBuildEvent>
			<Command>
				%(Command)
			</Command>
		</PostBuildEvent>

	</ItemDefinitionGroup>

</Project>
