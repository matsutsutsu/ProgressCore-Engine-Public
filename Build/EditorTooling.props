<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemDefinitionGroup>
		<ClCompile>
			<!-- エディタ用マクロとプロファイラ有効化 -->
			<PreprocessorDefinitions>
				ENABLE_EDITOR;
				TRACY_ENABLE;

				%(PreprocessorDefinitions)
			</PreprocessorDefinitions>

			<AdditionalIncludeDirectories>
				$(SolutionDir)Source\Editor;
				<!-- imgui-docking は EngineCore.props（全構成共通）へ移した。
				     ここに残すのはエディタ本体でしか使わないものだけ。 -->
				$(SolutionDir)External\imgui-node-editor;
				$(SolutionDir)External\ImGuizmo;
				$(SolutionDir)External\implot-master;
				$(SolutionDir)External\Tracy;
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>
	</ItemDefinitionGroup>
</Project>